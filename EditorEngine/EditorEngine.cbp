<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="EditorEngine" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/EditorEngine" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/EditorEngine" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=c++17" />
			<Add option="-m32" />
			<Add option="-g" />
			<Add directory="../sdl2/include/SDL2" />
		</Compiler>
		<Linker>
			<Add option="-O2" />
			<Add option="-m32" />
			<Add option="-lmingw32" />
			<Add option="-lSDL2main" />
			<Add option="-lSDL2" />
			<Add library="gdi32" />
			<Add library="user32" />
			<Add library="kernel32" />
			<Add library="comctl32" />
			<Add directory="../sdl2/lib" />
		</Linker>
		<Unit filename="include/Input_Users.h" />
		<Unit filename="include/imconfig.h" />
		<Unit filename="include/imgui.h" />
		<Unit filename="include/imgui_impl_sdl2.h" />
		<Unit filename="include/imgui_impl_sdlrenderer.h" />
		<Unit filename="include/imgui_internal.h" />
		<Unit filename="include/imstb_rectpack.h" />
		<Unit filename="include/imstb_textedit.h" />
		<Unit filename="include/imstb_truetype.h" />
		<Unit filename="main.cpp" />
		<Unit filename="src/Input_Users.cpp" />
		<Unit filename="src/imgui.cpp" />
		<Unit filename="src/imgui_demo.cpp" />
		<Unit filename="src/imgui_draw.cpp" />
		<Unit filename="src/imgui_impl_sdl2.cpp" />
		<Unit filename="src/imgui_impl_sdlrenderer.cpp" />
		<Unit filename="src/imgui_tables.cpp" />
		<Unit filename="src/imgui_widgets.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
