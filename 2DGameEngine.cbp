<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="2DGame_Engine" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/testGame" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../Game_Engine" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-std=c++17" />
					<Add option="-m32" />
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-O2" />
					<Add option="-m32" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/sdl prueba2" prefix_auto="1" extension_auto="1" />
				<Option working_dir="./" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-m32" />
			<Add option="-g" />
			<Add directory="sdl2/include" />
			<Add directory="box2d/include" />
		</Compiler>
		<Linker>
			<Add option="-m32" />
			<Add option="-lmingw32" />
			<Add option="-lSDL2main" />
			<Add option="-lSDL2" />
			<Add option="-lSDL2_image" />
			<Add option="-lbox2d" />
			<Add library="mingw32" />
			<Add library="user32" />
			<Add library="gdi32" />
			<Add library="winmm" />
			<Add library="dxguid" />
			<Add directory="sdl2/lib" />
			<Add directory="box2d/lib" />
		</Linker>
		<ExtraCommands>
			<Add after="XCOPY $(#sdl2)\bin\*.dll $(TARGET_OUTPUT_DIR) /D /Y" />
		</ExtraCommands>
		<Unit filename="include/Animation.h" />
		<Unit filename="include/Audio_System.h" />
		<Unit filename="include/Camera.h" />
